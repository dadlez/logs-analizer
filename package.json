{
  "name": "logs-analyzer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp fmt && vp lint && vp run test -r && vp run build -r",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "dev:api": "vp run api#dev",
    "dev:website": "vp run website#dev",
    "start:website": "vp run website#preview",
    "start:api": "vp run api#start",
    "build": "vp run --cache -r build"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.32.1"
}
